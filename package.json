{
  "name": "entysquare",
  "private": true,
  "version": "1.0.0",
  "description": "EntySquare - Modern Multi-chain Decentralized Exchange Platform with Concentrated Liquidity",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "version:prerelease": "npm version prerelease",
    "release:prepare": "npm run lint && npm run build",
    "release:check": "npm audit --audit-level=moderate",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name=entysquare-dex",
    "deploy:preview": "npm run build && npx wrangler pages deploy dist --project-name=entysquare-dex --compatibility-date=2024-01-17"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@lb-xyz/sdk": "5.0.14",
    "@lb-xyz/sdk-core": "2.0.13",
    "@lb-xyz/sdk-v2": "3.0.28",
    "@mui/icons-material": "^7.3.11",
    "@mui/lab": "^7.0.1-beta.25",
    "@mui/material": "^7.3.11",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "ethers": "^6.17.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-multi-carousel": "^2.8.6",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/nanoid": "^2.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.5.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6"
  }
}
